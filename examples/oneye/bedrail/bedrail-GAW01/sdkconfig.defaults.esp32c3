# =============================================================================
# gateway-c3 ?? ESP32-C3-Zero?4 MB flash / ? PSRAM / ? LCD?
# ?????sdkconfig.defaults ; sdkconfig.defaults.esp32c3 ; sdkconfig.defaults.esp32c3.mem
# =============================================================================

CONFIG_IDF_TARGET="esp32c3"
CONFIG_IDF_TARGET_ESP32C3=y

# ---- Flash?C3-Zero ?? 4 MB ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ---- ???????? partitions.csv?creds ???? 0x510000 ????????----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4mb.csv"

# ---- ??? LCD / ? GNSS / ? T31 ----
# CONFIG_ONEYE_T31_LCD_ENABLE is not set
# CONFIG_ONEYE_T31_GNSS_ENABLE is not set

# ---- ???????????? C6 ????----
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
