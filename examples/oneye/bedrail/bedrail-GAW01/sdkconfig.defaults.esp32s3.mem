CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_CTRL_BLE_MAX_ACT=3

# MQTT/TLS????? 118 B?1 KB ???????? 3 KB

# ??????????? cfg ???????
CONFIG_ONEYE_DEV_SDK_EVENT_Q_BYTES=2048
CONFIG_ONEYE_DEV_SDK_EVENT_Q_FRAMES=4
CONFIG_ONEYE_LINK_SCAN_ITVL_MS=200
CONFIG_ONEYE_LINK_SCAN_WINDOW_MS=200
# =============================================================================
# 2026-11-18??imBLE central ????????BLE ?????? T31 ??????+ ??????????????
# ????????/GATT ???????????/RPA ?????????????????????????? ~17 KB
