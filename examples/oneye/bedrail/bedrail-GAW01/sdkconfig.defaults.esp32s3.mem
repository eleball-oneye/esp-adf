CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
CONFIG_BT_NIMBLE_RPA_TIMEOUT=900
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_HS_PVCY=n
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=16
CONFIG_ONEYE_GAW01_TELE_MAX_DEV=8
CONFIG_ONEYE_GAW01_TELE_KEEPALIVE_MS=30000
CONFIG_ONEYE_GAW01_TELE_TEMP_DEADBAND=50
CONFIG_ONEYE_GAW01_TELE_BATT_DEADBAND=2
# CONFIG_ONEYE_GAW01_TELE_SIM is not set
CONFIG_ONEYE_GAW01_TELE_ALWAYS_SCAN=y
