menu "korvo2_llm_chat —— 云端 LLM 实时语音对话例程"

    menu "语音小服务（chatd，oneye.voice.v1）"

        config ONEYE_LLM_DEVICE_ID
            string "设备 SN（= session.start.device_id；**也是对话组密钥的派生输入**）"
            default "esp32s3korvo2"
            help
                设备标识。注意它不只是个名字（开发人员 2026-09-17 拍板：当前开发板 SN = esp32s3korvo2）：
                  ① 服务端按它做「每设备并发 1 会话」的隔离；
                  ② **服务端按它派生对话组正文的加密密钥**（HKDF-SHA256(ikm="sn:"+SN, salt=服务端 pepper)
                     → AES-256-GCM），并只按它回执/查询对话段；
                  ③ 控制台（Web）也是按 SN 查设备信息与对话组。
                因此**改这个值 = 换设备身份 = 换一套密钥与对话历史**：改完后旧 SN 下的历史仍在库里，
                但用新 SN 的密钥解不开（控制台仍能看到旧 SN 的设备条目，属预期）。
                密钥强度说明：SN 不是秘密（设备名/日志里都有），只靠 SN 派生只能防"库文件被直接翻看"；
                要做到"库泄露也解不开"，服务端必须另配 VOICE_STORE_PEPPER（见 backend 契约 §12.3）。

        config ONEYE_LLM_SERVER_HOST
            string "语音小服务主机（host 或 IP）"
            default "192.168.1.100"
            help
                指向部署了 backend chatd 的机器；台面联调可直接填开发机局域网 IP
                （Windows 上跑 chatd 时用 ipconfig 里的 IPv4 地址）。

        config ONEYE_LLM_SERVER_PORT
            int "端口"
            range 1 65535
            default 9091

        config ONEYE_LLM_WS_PATH
            string "WebSocket 路径（契约缺省 /v1/voice/ws）"
            default "/v1/voice/ws"

        config ONEYE_LLM_USE_TLS
            bool "使用 wss://（TLS）"
            default n
            help
                台面联调用 n（ws://，仅限同网段/研发）；生产形态必须 y 并配置受信 CA。

        config ONEYE_LLM_TLS_INSECURE
            depends on ONEYE_LLM_USE_TLS
            bool "TLS 跳过证书校验（仅 dev/台面）"
            default n

        config ONEYE_LLM_TOKEN
            string "会话令牌（session.start.token；服务端 VOICE_REQUIRE_TOKEN=1 时必填）"
            default ""

    endmenu

    menu "长按说话"

        config ONEYE_LLM_TALK_MIN_PRESS_MS
            int "长按判定阈值（ms；达到即开始收音）"
            range 200 3000
            default 600
            help
                REC 键按住达到该时长 → 开始采集并上行；松开 → 提交本轮（input.audio.commit）。
                短于该时长视为误触，直接丢弃本轮。
                该阈值同时写入板级 ADC 按键外设的 press_judge_time（覆盖板级缺省 3000 ms，
                见 components/audio_board/esp32_s3_korvo2_v3/board.c）。

        config ONEYE_LLM_TURN_MAX_MS
            int "单轮最长时长（ms；服务端限额 30000）"
            range 1000 30000
            default 30000

        config ONEYE_LLM_PLAY_VOLUME
            int "回放音量（0-100）"
            range 0 100
            default 80

        config ONEYE_LLM_SELFTEST_TURN_MS
            int "台面自检：自动走一轮（收音时长 ms；0 = 关闭）"
            range 0 10000
            default 0
            help
                置为非 0 时，语音面就绪后**自动**收音该时长并提交本轮（等价于「按住 REC 该时长后松开」），
                用于无人值守验证「上行采集 → 服务端 ASR/LLM/TTS → 下行 PCM → 喇叭回放」整条链路。
                ⚠️ 这是**台面/研发自检**开关（会不经按键就占用麦克风），量产必须为 0。

        config ONEYE_LLM_SELFTEST_NEW_CONV
            bool "台面自检：第 1 轮结束后自动发 conv.new（等价 SET 键单击）"
            default n
            depends on ONEYE_LLM_SELFTEST_TURN_MS > 0
            help
                打开后，第 1 轮 turn.end 之后自动请求开一段新对话（`conv.new`），
                服务端应回 `conv.state{reason:"new"}` 且 conv_id 变化、turns 归零。
                用于无人值守验证「按键起新对话 + 在新对话中继续」这条语义
                （SET 键的物理单击仍可人工验证；本开关只是让自动化跑得住）。
                ⚠️ 台面/研发自检开关，量产必须为 n。

        config ONEYE_LLM_SELFTEST_TURN_AFTER_NEWCONV
            bool "台面自检：新对话建立后再自动走一轮（验证「在新对话里继续」）"
            default n
            depends on ONEYE_LLM_SELFTEST_NEW_CONV
            help
                打开后，收到 `conv.state{reason:"new"}` 时在**新段内**再自动走一轮：
                新段应 turns 由 0 变 1、且**不继承**旧段上下文（服务端只送最近 N 轮，
                新段历史为空 → `stub` 档位下首轮回显「历史0条」）。
                与 `SELFTEST_NEW_CONV` 合用时，一次上电即可无人值守覆盖 P3 的
                「SET 键单击起新对话 + 在新对话中继续」两项。
                ⚠️ 台面/研发自检开关，量产必须为 n。

        config ONEYE_LLM_DIAG_HTTP_PROBE
            bool "台面诊断：建 WebSocket 前先做一次 HTTP GET /healthz"
            default n
            help
                打开后，语音面客户端启动前会对同一 host:port 发一次普通 HTTP 请求并打印结果，
                用于把「socket/lwIP 层面是否可用」与「WebSocket 组件是否有问题」分开定位
                （真机取证 2026-09-17：建 WS 客户端时出现 `Interrupt wdt timeout on CPU1`）。
                诊断用，量产保持 n。

        config ONEYE_LLM_PANEL_HEARTBEAT_S
            int "状态心跳周期（秒；0 附近取值可近似关闭）"
            range 5 600
            default 30

    endmenu

    menu "配网（本地面：BLE 自研 GATT + ESPTouch v2 + 凭据文件）"

        config ONEYE_LLM_NODE_ID
            string "本地面节点 id（link 帧 from/node.announce.node_id）"
            default "esp32s3korvo2"

        config ONEYE_LLM_ENABLE_WIFI_FILE
            bool "启用凭据文件配网（/sdcard/oneye-wifi.txt → /spiffs/oneye-wifi.txt）"
            default y
            help
                文件格式：逐行 `ssid=` / `password=`，`#` 注释；两侧空白与 CR 自动去除。
                ⚠️ 该文件是**明文** Wi-Fi 密码，仅用于台面/研发配网；量产固件必须置 n
                （改走 claim + 一机一密凭据，见总控 ADR-0007）。

        config ONEYE_LLM_ENABLE_BLE_PROV
            bool "启用 BLE 配网（oneye-dev-sdk 自研 GATT + POP 配对）"
            default y

        config ONEYE_LLM_ENABLE_SMARTCONFIG
            bool "启用 SmartConfig（ESPTouch v2）配网"
            default y
            help
                与 BLE 通道**并行**开启，先成功者胜出；设备侧复用 ESP-IDF 内置实现
                （契约 contracts/local/smartconfig.md：设备端口 7001、ACK 11 B）。

        config ONEYE_LLM_SMARTCONFIG_TIMEOUT_S
            depends on ONEYE_LLM_ENABLE_SMARTCONFIG
            int "SmartConfig 超时（s）"
            range 15 300
            default 60

        config ONEYE_LLM_WIFI_SSID
            string "Wi-Fi SSID 兜底（空且无凭据文件 = 不联网，仅启动配网通道）"
            default ""

        config ONEYE_LLM_WIFI_PASSWORD
            string "Wi-Fi 密码兜底"
            default ""

        config ONEYE_LLM_PROV_POP
            string "固定 BLE 配对 POP（6 位数字；空 = 随机生成并打印串口，TTL 300 s）"
            default ""

    endmenu

    menu "局域网链路（本地面 lan 信道：UDP 发现 + HTTP 帧面）"

        config ONEYE_LLM_ENABLE_LAN_LINK
            bool "启用局域网链路（明文，仅台面/研发）"
            default y
            help
                开启后：UDP 57321 应答 oneye.discover，并提供 POST /api/link/frame
                （见 contracts/local/lan-link.md）。⚠️ 明文信道，量产必须 n。

        config ONEYE_LLM_LAN_HTTP_PORT
            depends on ONEYE_LLM_ENABLE_LAN_LINK
            int "HTTP 帧面端口"
            range 1 65535
            default 80

    endmenu

    menu "板级外设"

        config ONEYE_LLM_ENABLE_SDCARD
            bool "启用 microSD（1-line；用于凭据文件）"
            default y

        config ONEYE_LLM_ENABLE_KEYS
            bool "启用 REC 键（长按说话）"
            default y

    endmenu

    config ONEYE_LLM_LOG_TEXT
        bool "把 ASR/LLM 文本打到串口日志（PIPL：正文不落盘；量产建议 n）"
        default n

endmenu
