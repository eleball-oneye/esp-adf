menu "korvo2_oneye 板级固件配置"

    config ONEYE_FW_DEVICE_ID
        string "设备 node_id（同时作为 MQTT username / client_id）"
        default "korvo2-0001"
        help
            对应契约 topic 中的 {node} 段（rmng/dev/{node}/...）。
            EMQX ACL 变量 %u 依赖 username，故默认三者同值。

            ⚠️ 它只是**台面占位**：量产机上真实身份来自 `creds` 分区的 node_id
            （`oneye_dev_creds_load()` → `oneye_dev_creds_apply()`），本项在真机上**不生效**。
            ⇒ ⛔ 不得把它当"这台设备的 SN"用（蓝牙广播的厂商字段因此**只**从 creds 取 SN）。

    config ONEYE_FW_PRODUCT_KEY
        string "产品品类 productKey（广播厂商字段携带的品类段来源）"
        default "OY-SPK-01"
        help
            Korvo-2 = `OY-SPK-01`（**已登记**：cloud/docs/00-naming-convention.md:4604-4607
            的机型清单，非本处新造）。它是**机型属性**、不是设备属性 ⇒ 允许来自构建配置
            （一台设备一个 node_id，但同机型共用一个 productKey）。

            用途：蓝牙扫描响应里的厂商自定义字段（AD 0xFF）只带 productKey 的**品类段**
            （`OY-<FAMILY>-<NN>` 中间的 FAMILY，如 `SPK`；3 B —— 31 B 广播包放不下全量，
            理由与字节布局见 contracts/local/ble-gatt.md 与 include/oneye_dev_ble.h）。
            空串 ⇒ 只带 SN、不带品类（App 侧 `pk_present=0`），⛔ 不填默认值。

    config ONEYE_FW_STATUS_INTERVAL_S
        int "status/up 周期 H（秒；0 = 按机型自动）"
        range 0 3600
        default 0
        help
            cloud 的在线会话键 TTL = **6 × H**，且**每条已认证上行**都会滑动续期
            （2026-10-21 `73dcfb7c`）⇒ 设备只要按 **≤ H** 的节奏发 `status/up`，
            在线键就不会过期（App 侧不会误判离线）。

            ⚠️ **H 必须与 cloud 侧该机型的配置一致**（机型配置在 cloud 侧）：
              · OY-SPK-01（甲 / Korvo-2 / 本工程）= **60**
              · OY-SPK-02（乙 / devkitc beta）        = 300
            两侧不一致的后果：设备发得比 H 慢 ⇒ 在线键过期（App 显示离线）；
            发得比 H 快 ⇒ 只多耗流量。cloud 改机型 H 时**必须**同步改这里
            （或改 `examples/oneye/oneye_status_period.h` 的机型表）。

            0 = **按 ONEYE_FW_PRODUCT_KEY 自动取**（推荐，机型即 H）。
            >0 = 显式覆盖（用于与 cloud 临时对齐；⛔ 改了它就要同步 cloud）。

            ⛔ 不得把 H 放进 shadow state：`heartbeatIntervalSec` 未进 TSL ⇒ 整帧被拒。
            ⛔ 不要用 0xFFFF 关心跳（那是 SDK 的"关闭"哨兵）：关了在线键就没人续。

    menu "接入（EMQX / 云端）"

        config ONEYE_FW_CLOUD_HOST
            string "云端主机（host 或 IP）"
            default "192.168.1.100"

        config ONEYE_FW_CLOUD_PORT
            int "端口（0 = 按承载取契约缺省：1883/8883/8083/8084）"
            range 0 65535
            default 0

        config ONEYE_FW_CLOUD_WS_PATH
            string "WebSocket 路径（空 = /mqtt，契约 §9）"
            default ""

        config ONEYE_FW_CLOUD_TOKEN
            string "设备令牌 token（空 = 匿名/dev 形态）"
            default ""

        choice ONEYE_FW_TRANSPORT
            prompt "承载（契约：tcp 1883 / tls 8883 / ws 8083 / wss 8084）"
            default ONEYE_FW_TRANSPORT_TLS
            config ONEYE_FW_TRANSPORT_TCP
                bool "MQTT over TCP（开发/联调）"
            config ONEYE_FW_TRANSPORT_WS
                bool "MQTT over WebSocket（/mqtt）"
            config ONEYE_FW_TRANSPORT_TLS
                bool "MQTT over TLS（生产主承载，一机一密）"
            config ONEYE_FW_TRANSPORT_WSS
                bool "MQTT over WSS（/mqtt）"
        endchoice

        config ONEYE_FW_TLS_INSECURE
            bool "TLS 跳过证书校验（仅 dev/产测；生产必须 n）"
            default n
            help
                置 y 时 SDK 会打 WARN。生产形态为一机一密 + 自研 CA，
                须通过 oneye_dev_base_config_t.tls_ca_pem 投放 CA，不得跳过校验。
    endmenu

    menu "Wi-Fi"

        config ONEYE_FW_ENABLE_WIFI_FILE
            bool "启用凭据文件配网（SD 卡 /sdcard/oneye-wifi.txt → SPIFFS 兜底）"
            default y
            help
                置 y：启动时先读凭据文件（`ssid=` / `password=` 逐行，`#` 注释），
                命中即以文件为准连接；未命中再回落到下面的 Kconfig SSID。

                ★ 这是**机型能力位**（ADR-0017 D3）：**有卡槽机型 y / 无卡槽机型 n**。
                  ⛔ 它**不是**「量产 vs 台面」开关 —— 旧 help 曾写「量产形态必须关闭（n）」，
                  后果是纯生产件一个配网通道都不剩、`oneye_start()` 永不调用、设备上不了云
                  （2026-10-07 真机实测）。构建期门禁（main/CMakeLists.txt）现在保证
                  「一个可用通道都没有」的配置**编不过**。
                ⚠️ 文件在 SD 卡上是**明文** Wi-Fi 密码：有加密通道（BLE）的机型应以 BLE 为首选通道；
                  该残余风险的归属见 ADR-0017 D3。
                🔴 **2026-10-13 就地订正（用户裁定，最高依据）**：本项支持的文件通道是
                  **量产品类形态**（不是"仅台面"能力）—— 用户逐字口径「**B1.量产支持且凭据明文**」，
                  即「**量产支持该通道 ＋ 凭据明文**」，明文密码这一后果**已由用户裁定接受**。
                  ⛔ 不得再把它写成"仅台面可用 / 明文是未决残余风险"；旧字逐字留痕（⛔ 不抹）：
                  本行上方旧口径逐字为
                  「⚠️ 文件在 SD 卡上是**明文** Wi-Fi 密码：有加密通道（BLE）的机型应以 BLE 为首选通道；
                    该残余风险的归属见 ADR-0017 D3。」
                  ⛔ 行为未改：rank 仍是 FILE 0 > BLE 1 > default 2（`wifi_prov_policy.h` 逐字未改）；
                  本条**只是口径订正**（机型能力位/量产品类形态的正名）。
                同时该开关控制本地验证面的 /api/action wifi_set（运行期换网，通道 C4）。

        config ONEYE_FW_WIFI_SSID
            string "Wi-Fi SSID（兜底；空且无凭据文件 = 不联网，仅跑板级自检）"
            default ""

        config ONEYE_FW_WIFI_PASSWORD
            string "Wi-Fi 密码（兜底）"
            default ""

        config ONEYE_FW_ENABLE_BLE_PROV
            bool "启用 BLE 配网通道 C1/C2（oneye-dev-sdk 自研 GATT + 激活码配对）"
            default n
            depends on ONEYE_DEV_SDK_ENABLE_BLE
            help
                配网通道 C1（手机 App）与 C2（另一台嵌入式设备）：BLE 上跑 link 帧，
                由 App/对端下发 SSID/密码（契约 contracts/local/ble-gatt.md）。
                设备侧复用 SDK 的 `liboneye_dev_ble`（自研 GATT；配对凭据 =
                **激活码（`prov.pair.code`，用户从机身贴码输入）＋ 一次性 `chal`**
                → HKDF-SHA256 → AES-128-GCM；⛔ POP（6 位数字）已按用户 2026-10-09 裁定彻底删除），
                实现见 main/wifi_prov_ble.c —— 它**只**把凭据交给 wifi_prov_submit_credentials()，
                入网后动作统一由 main/wifi_prov.c 的收敛点触发（ADR-0017 D2）。

                依赖 `ONEYE_DEV_SDK_ENABLE_BLE=y`（SDK Kconfig），并需要 NimBLE 主机
                （`CONFIG_BT_ENABLED=y`）与 Wi-Fi/BLE 共存；内部 RAM 代价见 ADR-0017 D6
                与 sdkconfig.defaults.ble 的逐项注释。
                **无 SD 卡槽的机型应打开本项**（此时 WIFI_FILE=n，由构建期门禁保证仍有通道）。

                🔴 **2026-10-20 补充（用户裁定，最高依据）**：「com12 甲型需要支持蓝牙配网使能，
                  **拔出 SD 卡的时候用蓝牙配网，有 SD 卡时用 SD 卡凭据配网**」
                ⇒ **有卡槽机型（甲型 OY-SPK-01）同样打开本项**，作为 **SD 缺失/解析失败时的回退**
                  （`sdkconfig.defaults.production` 已固化；旧状态逐字留痕：该预设此前不含 BLE 符号
                  ⇒ 拔卡后"一个配网通道都没有"，2026-10-20 真机取证）。
                ⚠️ 该组合下"有 SD 时不启 BLE"由**代码结构**保证、⛔ 不是运行期开关：
                  卡上凭据解析成功 ⇒ `wifi_prov_boot()` 在 BLE 段之前 `return` ⇒ NimBLE 不起栈；
                  卡缺失 / 文件缺失或解析失败 / 卡上凭据本次入网失败 ⇒ 才落到 BLE 段。
                ⚠️ 拔插卡**不在运行期热切换**：SD 只在上电时挂载/读取一次 ⇒ 切通道要**复位**。
                ⛔ 身份来源不变：BLE 只下发 Wi-Fi 凭据，甲型连云身份仍只来自 `creds` 分区
                  （⛔ 不得用激活码顶替 creds 身份）。

        # ⛔ 旧项逐字留痕（⛔ 不抹）——`config ONEYE_FW_BLE_POP` / `string "固定 BLE 配对 POP
        #   （6 位数字；空 = SDK 随机生成并打印串口，TTL 见 SDK 配置）"`：按用户 2026-10-09 裁定
        #   「彻底删除实现及契约」整项删除（台面注入口 ⇒ 无处可注）。

        # =====================================================================
        # 🔴 设备侧档位（甲 / 乙 / 丙）—— 2026-10-10 本批新增的**三值**机型位
        #
        # 为什么必须三值（⛔ 不能继续用"要不要激活凭证"这个布尔）：
        #   · 契约 `contracts/local/ble-gatt.md` §4.4.2 / §4.4.4 逐字：`cred_req=false`
        #     **对乙 / 丙 同时成立** ⇒ 旧布尔**只能判甲 vs（乙 | 丙）**，**判不出乙与丙**；
        #   · 而乙与丙在 `prov.verify.req` 上的行为**不同**：乙 **必经**（判据 = `node_id` 的
        #     形态 / 有效性），丙 **SKIP**（⛔ 一帧不发）。这个差别只能由**档位**承载。
        #
        # ⚠️ 与云端 `onboarding_actor` 的关系（一致性由谁保证）：
        #   **构建期声明（本 choice）＋ 契约要求二者对同一 `product_key` 必须一致**；
        #   ⛔ **不是**"云侧下发"（配网期设备无网、厂商字段里又没有 `productKey`；
        #   见下面各项 help 与 `wifi_prov_ble.c` 的启动日志）。
        #   **权威值在云侧**（`dev_product_credential_policy.credential_required` ＋
        #   `onboarding_actor`，经只读端点 `resolve` 的 `onboardingActor` 给 App）；
        #   本项是**设备自称**，用于回答"设备自己在没有网的时候该怎么处置 `prov.verify.req`"。
        # =====================================================================
        choice ONEYE_FW_ONBOARDING_ROLE
            prompt "设备侧档位（甲 / 乙 / 丙；契约 ble-gatt.md §4.4.2，须与云 onboarding_actor 一致）"
            depends on ONEYE_FW_ENABLE_BLE_PROV
            default ONEYE_FW_ONBOARDING_ROLE_ALPHA
            help
                三型定义（契约 §4.4.2 的矩阵逐字）：

                | 档位 | 物理事实 | `cred_req` | `prov.verify.req` |
                | 甲 ALPHA | 有 creds（一机一密）＋能连云 | true | **必经**：与自身 `creds.node_id` 逐字比对 |
                | 乙 BETA  | 无 creds ＋ 品类级内嵌证书 ＋能连云 | false | **必经**：判据 = `node_id` 的**形态 / 有效性** |
                | 丙 GAMMA | 无 creds ＋ 连不上云（入网能力全交 App） | false | **SKIP**：⛔ 不发现场帧 |

                ★ **缺省 = 甲（最严）**：与 cloud 机型表读不到时 fail-closed 取 `true`、
                  §4.4.7「失败方向写死 = 最严」**同向**；⛔ 不是"默认放宽"。
                ★ **未声明档位**（SDK 侧 `adv_device_tier_set = false`）⇒ 三态判据 fail-closed 按**甲**。
                ★ 乙的判据⛔ **不是身份证明**：乙**无设备级秘密** ⇒ 本地**不可能**证明
                  「这个 `node_id` 就是我」⇒ 形态判据拦的是「空码 / 形态非法」，
                  **权威在云侧准入**（设备拿该 `node_id` 连服务时由云侧裁决）。

            config ONEYE_FW_ONBOARDING_ROLE_ALPHA
                bool "甲 ALPHA：有 creds 一机一密 ＋ 能连云（`prov.pair` 逐字比对 ＋ verify 必经）"
            config ONEYE_FW_ONBOARDING_ROLE_BETA
                bool "乙 BETA：无 creds ＋ 品类级内嵌证书 ＋ 能连云（verify 必经：形态判据）"
            config ONEYE_FW_ONBOARDING_ROLE_GAMMA
                bool "丙 GAMMA：无 creds ＋ 连不上云（verify **SKIP**：⛔ 一帧不发）"
        endchoice

        config ONEYE_FW_DEV_CRED_REQUIRED
            depends on ONEYE_FW_ENABLE_BLE_PROV
            bool "本机型**需要激活凭证**（⇒ 配答应答 prov.pair.ok 的 cred_req=true）"
            default y
            help
                ⚠️ **2026-10-10 起本项降级为「旧载体 / 兼容载体」** —— 它**只能判甲 vs（乙 | 丙）**
                （契约 §4.4.4 逐字：这一格**判不出乙与丙**）⇒ **三态分型请用上面的
                `ONEYE_FW_ONBOARDING_ROLE`**；本项保留只为"取值与 cloud 的
                `dev_product_credential_policy.credential_required` 同源"这一可读性。

                语义与 cloud 的 `credential_required`（0=不需要 / 1=需要 / NULL=没答案）**同源**；
                cloud 侧读不到那一格时 **fail-closed 视为「需要」**
                （见 `DeviceProductCredentialPolicyMapper` / `DeviceActivationResolveDto`）
                ⇒ 本项**缺省 y（需要）与之同向**，⛔ 不是"默认放宽"。

                ★ 为什么设备侧由**编译期**承载（而不是 creds 字段 / 空口字段）：
                  ① 配网期设备**无网**，拿不到 cloud 的机型表；
                  ② 厂商字段里的 `pk_family` 段已按台账 #3 **删除** ⇒ 空口上已无机型信息，
                     设备无法自己查表；
                  ③ creds 镜像的字段集是**产线灌注契约**（`oneye_dev_creds_load()` 解析的键集），
                     ⛔ 本批**不得**自行新增 creds 键（那要改灌注侧与镜像格式，属另一次决策）。
                  ⇒ 只能由**机型位**（本 Kconfig，随机型 sdkconfig.defaults 固化）承载。
                ★ **一致性**：本项取值必须与档位 choice **一致**（甲 ⇔ y；乙 / 丙 ⇔ n）——
                  `wifi_prov_ble.c` 在编译期用 `#error` 拦下"两个载体打架"（⛔ 不静默选一边）。
                  取值经 `oneye_dev_ble_config_t.adv_cred_required(_set)` 进入 SDK，
                  在**明文** `prov.pair.ok` 里以布尔 `cred_req` 回给 App（可选字段：置本项即发送）。
                ⚠️ 它不是"授权决定"：是否真的放行绑定由 **cloud 的机型表 + App 代云校验**裁定
                （台账 #8 / #9），设备侧这一位只是**如实转述**自己的机型档位。

        config ONEYE_FW_BLE_PROV_KEY_GATE
            depends on ONEYE_FW_ENABLE_BLE_PROV
            bool "BLE 配网改由按键进入/退出（长按 SET；开机只待机不广播）"
            default n
            help
                置 y（**本批新语义**）：开机把 NimBLE 起栈并打印 `[res]` 读数，但**不广播**（待机）；
                长按 SET 键进入配网模式（开始广播、串口打印**本机型是否需要激活凭证**与剩余时间），
                **再长按一次**退出；
                进入后 `ONEYE_FW_BLE_PROV_PAIRING_WINDOW_S` 秒内没有设备入网 ⇒ 自动退出；
                入网成功仍由收敛点（`on_wifi_ready()`）停广播。

                ⚠️ 置 y 的代价（**必须知情**）：启动期不再接受配网 ⇒ 若无人长按 SET，
                   `wifi_prov_submit_credentials()` 永不会被调用、`oneye_start()` 永不被调用，
                   设备**不会上云**（串口会打印"待机"与"长按 SET"指引）。
                置 n（缺省，= 旧行为）：开机即广播，随时可配网；此时长按 SET 仍可**退出/重新进入**
                   配网模式（退出后同样靠再长按进入）。
        config ONEYE_FW_BLE_PROV_PAIRING_WINDOW_S
            depends on ONEYE_FW_ENABLE_BLE_PROV
            int "BLE 配网模式超时（秒；进入后无成功入网则自动退出广播）"
            range 30 3600
            default 300
            help
                按用户口径取 300 s，与 SDK 的一次性 challenge（配对凭据）有效期
                `CONFIG_ONEYE_DEV_SDK_BLE_CHAL_TTL_S`（缺省 300 s；⚠️ 旧名逐字留痕：
                `CONFIG_ONEYE_DEV_SDK_BLE_POP_TTL_S`，POP 已按用户 2026-10-09 裁定彻底删除）对齐 ⇒
                「chal 失效」与「配网窗口关闭」是同一刻，串口上的剩余时间与 App 侧看到的有效期一致。
                ⚠️ 若把本值调**大于** chal TTL，则 chal 会先在窗口内轮换（App 侧需重新取 chal）——
                   仍可用，但两端"有效期"不再一致，故非必要不要偏离 300。

                ★ 2026-10-09 实测确认的机制（两条，都要记住）：`sdkconfig.h` 只对 **y 的 bool** 产出
                   `#define`；**n 的 bool 与"依赖不满足"的符号都不会有任何宏**。
                   ⇒ ① 顶层用 `#if CONFIG_ONEYE_FW_BLE_PROV` 判通道是必要的（本项为 n 时该宏不存在）；
                     ② 用到本项的代码必须按 y/n 都写出**确定的**语义，
                        ⛔ 不能用 `!CONFIG_ONEYE_FW_BLE_PROV_KEY_GATE` 这种"n 时也成立"的写法
                        （n 时宏不存在 ⇒ `!0` = 1 ⇒ 语义被静默翻成 y）。
                   本项放在 `menu "Wi-Fi"` 内 + 逐项 `depends on`：既被机型位门控，又不改变上面这个机制。
    endmenu

    menu "板级外设（默认关闭：未确认项不据推测启用）"

        config ONEYE_FW_ENABLE_SDCARD
            bool "启用 microSD（1-line；无卡检测引脚）"
            default y
            help
                本板仅支持 SD_MODE_1_LINE（board.c:173-201），
                SDCARD_INTR_GPIO = -1（board_def.h:61）⇒ 无插拔事件，只上报挂载成败。
                缺省 y：Wi-Fi 凭据文件（oneye-wifi.txt）与 AEC 录音/板上回放都落在 SD 卡；
                未插卡只是挂载失败并打印告警，不阻塞启动（录音自动落 SPIFFS）。

        config ONEYE_FW_ENABLE_LCD
            bool "启用 LCD（ILI9341 320x240，SPI2 + TCA9554）"
            default n

        config ONEYE_FW_ENABLE_KEYS
            bool "启用 6 键 ADC 按键（REC/MUTE/PLAY/SET/VOL-/VOL+）"
            default y

        config ONEYE_FW_ENABLE_MPP
            bool "启用 mpp 域（媒体会话；本轮默认关）"
            default n
            help
                媒体数据面（webrtc/http_upload/mqtt_frame）尚未在真机验证，
                默认关闭；打开仅初始化 mpp 域，不发起会话。

        config ONEYE_FW_DECLARE_VIDEO_LIVE
            bool "在 caps/up 声明 video.live（须真机取帧取证通过后才可开）"
            default n
            help
                契约红线：未实现/未验证的能力不得声明。开启前须完成
                backend/contracts/api/mqtt/Korvo-2设备能力与协议映射.md §6-1 真机取证。
                audio.intercom 在 WebRTC 数据面落地前一律不得声明（本固件不提供开关）。

        config ONEYE_FW_LOG_PROBE
            bool "log 面取证插桩（周期性 INFO 记录 + 长批量间隔；仅取证用）"
            default n
            help
                **默认关，不要在生产固件里开。** 本固件平时只有开机自检那一行走 SDK 的
                log 面（其余是 ESP-IDF 本地日志，SDK 内部日志按设计也不经 log 库上行），
                所以板上 log/up 面几乎无流量 —— `log/down` 的 set_uplink / dump 的
                **效果**在真机上无从观测。打开本开关后：每 3 s 经公开 API 写一条 INFO
                记录（每第 5 条再补一簇 5 条），并把批量间隔拉到 20 s、关掉"条数早发"，
                让缓冲里的记录停得住，从而可观测 dump 的窗口语义。
                取证结论见 backend/contracts/api/mqtt/传输规范.md §8.1。
    endmenu

    menu "验证面板（本地验证面，非云端契约）"

        config ONEYE_FW_PROV_ATTEST
            bool "开机打印产测自证串（ONEYE-PROV1 …）"
            default y
            help
                用 creds 分区里的私钥签一段规范化文本并打印一行（不带日志前缀），产线上位机用
                该设备的证书验签 ⇒ "这台机器真的持有与台账匹配的私钥"（契约
                backend/contracts/domain/设备凭据分区与产测自证契约.md §6）。

                为什么需要：伙伴产线的凭证分区在哪个**偏移**我们不确定，"回读一段 flash 再比对"
                走不通；而且回读只证明"flash 里有这份字节"，不证明"这台设备真的能用它上线"。

                为什么**缺省开**（v0.4.0 起由 n 改为 y）：量产与产测必须是**同一份固件** ——
                产线流程是"批量签发每台的 SN/证书 → 把这些产物写进该机的 creds 分区 → 开机采到
                这一行交给上位机验签 → 出厂结束"。如果这一行要靠编译期开关打开，产线就得再维护
                "产测固件"与"量产固件"两个镜像，而**发错固件**（把没开开关的那份发给产线）会让
                整个产测环节静默失效：设备照常上线、就是采不到自证串。
                代价只有"每次开机多一行"：它只在**分区里有一份合法镜像**时打印（没写分区的机器
                什么都不打，产线当场就能看出这台没灌注），且不含新的秘密（node_id 与证书指纹对
                拿到设备的人本来就可读；签名带随机 nonce，不可重放）。确需静默的台面构建可显式关。

        config ONEYE_FW_ENABLE_PANEL_API
            bool "启用设备侧本地验证 HTTP API（/api/status、/api/selftest、/api/keys）"
            default y
            help
                供宿主验证面板（embedded/esp-adf/tools/panel/）与其他联调工具读取：
                板级自检明细、按键实时状态与历史响应（本地检测 → event/up → 云端 ack）。
                该 API **不是**云端设备面契约（不进 backend/contracts、不新增 topic/影子键），
                仅为台面联调；**量产固件应置 n**。

        config ONEYE_FW_PANEL_PORT
            depends on ONEYE_FW_ENABLE_PANEL_API
            int "本地验证 API 端口"
            range 1 65535
            default 80

        config ONEYE_FW_KEY_HISTORY_MAX
            depends on ONEYE_FW_ENABLE_PANEL_API
            int "按键历史保留条数"
            range 8 256
            default 64

    endmenu

    menu "AEC 采集（录音 → web 播放）"

        config ONEYE_FW_ENABLE_AEC_CAPTURE
            bool "启用 AEC 采集（esp-sr AFE：AEC + 降噪 → WAV 落盘）"
            default y
            help
                采集链：I2S0 16 kHz/32 bit/RIGHT_LEFT（ES7210 四通道 "RMNM"）→ algorithm_stream
                （AFE_TYPE_SR 双麦）→ wav_encoder（16 kHz/16 bit 单声道）→ fatfs_stream。
                落盘：SD 可用 → /sdcard/rec/aec-N.wav；否则 SPIFFS 兜底 → /spiffs/rec/aec-N.wav。
                文件由本地验证面 GET /media/list 列出、GET /media/<alias>/<path> 播放（带 Range）。
                关闭后固件不再链接 esp-sr AFE（体积更小；面板音频卡片显示不可用）。

        config ONEYE_FW_AEC_DEFAULT_S
            depends on ONEYE_FW_ENABLE_AEC_CAPTURE
            int "缺省录音时长（秒，0 表示由请求指定）"
            range 1 120
            default 5

    endmenu

    config ONEYE_FW_SELFTEST_STRICT
        bool "板级自检失败即中止上云（推荐）"
        default y

    config ONEYE_FW_DIAG_PROV_TRACE
        bool "诊断构建：配网链路逐步留痕（默认 n；只由 sdkconfig.defaults.diag 打开）"
        default n
        help
            仅用于**诊断固件**：量产预设 sdkconfig.defaults.production ⛔ 不设本项 ⇒ 默认 n
            ⇒ 下面这段代码在量产件里**根本不编进去**（⛔ 不改变量产固件的日志面）。

            打开后额外产出（全部 INFO/WARN，⛔ 不含密码 / 激活码 / chal / 令牌）：
              1) 开机回显**运行期生效的日志级别**（esp_log_level_get 与编译期缺省/上限），
                 并把 wifi_prov / wifi_prov_ble / oneye_ble 三个 tag 放宽到 DEBUG；
              2) 5 s 一次心跳（SDK 配网状态 + Wi-Fi 状态快照）—— 证明"串口是活的、级别是 INFO"，
                 把"INFO 被日志级别滤掉"与"抓取窗口晚于开机"这两种解释分开；
              3) SDK 侧配网状态事件回显（与 BLE 是否真发出**无关**）：区分
                 "SDK 没上报"与"上报了但没送达对端"。

            ⛔ 不新增帧 / ⛔ 不改帧字段 / ⛔ 不改状态机 / ⛔ 不改错误码。日志**级别**本身由
            sdkconfig.defaults.diag（构建期）决定；本开关只决定"要不要多打这几行"。

endmenu
