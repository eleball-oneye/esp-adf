#
# korvo2_oneye 通用缺省（板级参数见 sdkconfig.defaults.esp32s3）
#
# Bootloader / 分区表：分区表放在 0x8000、**自定义分区表**（见下面的 CONFIG_PARTITION_TABLE_CUSTOM；
# 布局与逐项取舍写在 partitions.csv 顶部的注释里）。
# ⚠️ 这里**故意不写** `CONFIG_PARTITION_TABLE_SINGLE_APP=y`（2026-09-30 放分区时删掉）：
#    它与 `CUSTOM=y` 是同一个 choice 的两个成员，"两行都写"只是靠"后写者胜"才成立，
#    读起来却像两条同时生效 —— 分区表只有一处选择，就只留一处。
CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x1000
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_MD5=y

# ESP-ADF（v2.8）与 ESP-IDF 5.5 共栈需要：FreeRTOS 向后兼容
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_ESPTOOLPY_BEFORE_RESET=y

# 板级自检需要 INFO 日志完整打印（[board-check] 逐行结论）
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# 这里原本写的是 `CONFIG_LOG_MAXIMUM_LEVEL_INFO=y` —— **它什么都做不了**（2026-09-24 门禁抓到）：
# IDF 的 `config LOG_MAXIMUM_LEVEL_INFO` 带 `depends on LOG_DEFAULT_LEVEL < 3`，而上一行已经把
# 缺省级别设成 INFO(=3) ⇒ `3 < 3` 为假 ⇒ 该成员不可选，写进 defaults 会被静默丢弃，
# choice 落回 `LOG_MAXIMUM_EQUALS_DEFAULT`（即 max = 缺省 = INFO，效果恰好一致，所以一直没人发现）。
# 显式钉 `LOG_MAXIMUM_EQUALS_DEFAULT`：它**是**一个真实符号（会出现在 sdkconfig 里、门禁看得见），
# 语义也正是本工程要的"运行期可调到缺省级别"，且将来有人改缺省级别时这里不会被悄悄带跑。
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y

#
# 分区表：自定义（**开发板台面形态**：factory 4M + model 1M + creds 16K@0x510000 + storage 1M）
#   为什么必须自定义：
#     ① esp-sr 的 AFE 要求分区表里存在名为 `model` 的分区，否则 `srmodels.bin` **从不投放**
#        （`components/esp-sr/CMakeLists.txt:78-100`，上游不打印任何提示）；
#     ② IDF 缺省 `factory` 只有 1 MB，而本应用（ADF 播放链 + esp-sr + oneye-dev-sdk 四库 + Wi-Fi + 本地面板）
#        实测约 1.97 MB；
#     ③ 无 SD 卡时录音需要 SPIFFS 兜底（`/spiffs/rec`）。
#   2026-09-30 放大的**唯一目的**是给 app 留余量：`factory` 2M→4M（放大前实测只剩 1%，构建期告警
#   `The smallest app partition is nearly full …`，继续加功能必炸）。
#   🔴 `creds` 被**钉在 0x510000**（板上已按该偏移烧好 per-device 凭据；挪了 = 把真机身份弄丢）
#      ⇒ 本表是**开发板台面形态**；**量产分区形态需单独评审**（用户裁定：实际生产设备 flash 更充裕）。
#   逐项取舍（为什么缩 model、为什么 storage 移到 creds 之后）见 partitions.csv 顶部注释。
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# PSRAM：AFE/音频任务的 ext-stack 与录音缓冲需要（Korvo-2 板载 ESP32-S3-WROOM-1 带 Octal PSRAM）
#   注：若实物模组为 Quad PSRAM，请把 MODE_OCT 改为 MODE_QUAD（见 README「待真机核对」）。
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
#
# 内部/DMA 内存保留（真机修复 2026-09-15）：Wi-Fi + oneye-dev-sdk + esp-sr AFE 同时跑时，
# SDMMC 写卡需要 MALLOC_CAP_DMA 的内部缓冲，缺了会报
#   sdmmc_cmd: allocate_dma_buf: not enough mem, err=0x101
#   diskio_sdmmc: sdmmc_write_blocks failed (0x101)
# ⇒ 录音文件只有 0 字节（"录不满时长/没声音"的真因）。把保留量从缺省 32 KB 提到 64 KB。
#
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
#
# 内部 RAM 减压（真机修复 2026-09-15）：IDF 缺省把「小于 16 KB 的一般分配」都放内部 RAM，
# 于是 Wi-Fi + SDK + AFE 迅速吃光内部 RAM，出现
#   AUDIO_THREAD: Error creating RestrictedPinnedToCore algo_fetch
#   ALGORITHM_STREAM: Failed to create algo_fetch task
#   AFE: afe_feed: handle or input data is NULL!
# ⇒ AFE 取不到帧 ⇒ 录音只有 44 B 头。把阈值降到 4 KB，让中等分配走 PSRAM。
#   实测：internal_free 39 KB→88 KB、internal_largest 15 KB→40 KB，录音恢复正常。
#
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

#
# FATFS（SD 卡上的录音/媒体文件名可能较长）
#
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_FS_LOCK=5

#
# SPIFFS（兜底录音存储）
#
CONFIG_SPIFFS_MAX_PARTITIONS=3

#
# 板级功能开关（Kconfig 缺省已为 y；此处显式固化，保证「删掉 sdkconfig 后重建」结果一致——
# Kconfig 的 default 只对**新建** sdkconfig 生效，改 default 不会改动既有 sdkconfig）
#
# 凭据文件配网：SD 卡根目录 oneye-wifi.txt → 开机自动配网（量产固件必须置 n）
CONFIG_ONEYE_FW_ENABLE_WIFI_FILE=y
# microSD：凭据文件、AEC 录音落盘、板上回放都依赖它（未插卡仅告警，不阻塞启动）
CONFIG_ONEYE_FW_ENABLE_SDCARD=y

# ---- log/up：让板级**真的**有日志上行（2026-09-30 本轮目标之一） -------------------------
# 为什么要显式开：本固件平时**只有开机自检那一行**走 SDK 的 log 面（`ONEYE_LOGI`，main/korvo2_oneye_main.c
# 的 oneye_start 第 6 步），其余日志全是 ESP-IDF 的 `ESP_LOG*`（只落本地栈），而 SDK **内部**日志按设计
# 也不经 log 库上行 ⇒ 板上 `rmng/dev/<node>/log/up` 面**几乎无流量**，于是 `log/down` 的
# set_uplink / dump 的**效果**在真机上无从观测（2026-09-21 真机复验实测：19 条下行全部投递成功、
# 串口逐条有日志，broker 侧一帧 `log/up` 都没有）。取证结论见
# backend/contracts/api/mqtt/传输规范.md:251-259。
#
# 这个开关（main/Kconfig.projbuild:105-115）做的事：用**既有公开 API** 每 3 s 写一条 INFO 记录
# （每第 5 条再补一簇 5 条），并把批量间隔拉到 20 s、关掉"条数早发"，让记录在缓冲里停得住
# （`log/down dump` 的窗口语义才可观测）。实现见 main/korvo2_oneye_main.c 的 log_probe_task。
#
# 速率核算（对照 backend/contracts/api/mqtt/传输规范.md:149 的 log/up 限额 ≤1 帧/s、基线 ≤16 KB/s）：
# 每 15 s 共 10 条（5 个 tick + 1 簇 5 条）× 约 60–100 B ≈ 4–7 KB/min ≈ 0.1 KB/s，且 20 s 才组一帧
# ⇒ 离"高频"极远（帧率 0.05 帧/s、字节率约为基线的 0.6%）。SDK 另有 32 KB/帧与 16 KB/s 限速兜底。
#
# ⚠️ 这是**取证插桩**（Kconfig help 逐字"仅取证用"）：量产预设
# `sdkconfig.defaults.production` 的「台面能力一律关闭」段里显式写着
# `# CONFIG_ONEYE_FW_LOG_PROBE is not set`（2026-10-07 复核时在 `:68`；同段 `:64`/`:66`
# 是明文 Wi-Fi 凭据文件与 PANEL_API 两条同类关闭项。行号会随该文件增补漂移，**以符号为准**），
# 且后叠加者胜 ⇒ **量产口径不受本行影响**。
# 为什么本轮选它而不是装 platform hook（`oneye_dev_log_install_platform_hook()`，
# components/oneye-dev-sdk/include/oneye_dev_log.h:140，那条路能让真实 ESP_LOG 也上行）：
# hook 会替换全局 `esp_log_set_vprintf` 调用链，属"改整机日志路径"，本轮**无真机可验**
# （不烧写、不占串口）；而本开关只在既有任务里多写几条记录，风险面小得多。hook 路线登记为未做项。
CONFIG_ONEYE_FW_LOG_PROBE=y

# ---- 承载：**必须钉死** ---------------------------------------------------------
# 为什么钉：本工程 Kconfig 里承载 choice 的缺省是 TCP（dev/联调），而 SDK 对"承载不是 TLS 却给了
# tls_ca_pem"是**报错**的（一对矛盾配置早报早好）。于是只要 sdkconfig 被"从 defaults 重新生成"
# 一次，承载就会掉回 TCP ⇒ base init 失败 ⇒ **设备根本不上线**（2026-09-22 真机实测踩到）。
# 生产主承载是 mqtt-tls（一机一密）；要联调明文请显式改这一项。
CONFIG_ONEYE_FW_TRANSPORT_TLS=y
# ---- 开发板的目标平台：**同样钉死** ---------------------------------------------
# 与承载同理：本工程 Kconfig 的缺省是占位地址（192.168.1.100:0）。sdkconfig 一旦"从 defaults
# 重新生成"，云端地址就会掉回占位值 ⇒ 设备能起来但**连不到平台**（2026-09-22 真机实测踩到）。
#
# ⚠️ **端口必须与"信任签发 CA 的那台监听器"一致**（2026-09-24 更正，原值 18885）：
#   台面固件同样要连平台 CA 那台 —— 申领服务签发的设备证书挂在平台 CA（`oneye-iot-device-ca`）下，
#   而只有 `oneye-platca` 那台 broker 的 cacertfile 是平台 CA（宿主端口 **18886**）。
#   原来的 18885 是另一台老 CA 的监听器：拿平台证书去连**必被拒**，现象像"证书坏了"。
#   现在 broker 已收成稳定形态（`backend/deployment/broker/`：一台 broker、两个监听器），
#   18886 仍然是设备面的固定端口 ⇒ 台面与产线用同一个端点，不再有两套口径。
CONFIG_ONEYE_FW_CLOUD_HOST="mqtt.oneye.me"
CONFIG_ONEYE_FW_CLOUD_PORT=18886