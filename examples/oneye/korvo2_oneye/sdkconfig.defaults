#
# korvo2_oneye 通用缺省（板级参数见 sdkconfig.defaults.esp32s3）
#
# Bootloader / 分区：与 ADF 例程口径一致（单 App 分区，偏移 0x1000）
CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x1000
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_MD5=y

# ESP-ADF（v2.8）与 ESP-IDF 5.5 共栈需要：FreeRTOS 向后兼容
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_ESPTOOLPY_BEFORE_RESET=y

# 板级自检需要 INFO 日志完整打印（[board-check] 逐行结论）
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

#
# 分区表：自定义（factory 2M + storage 1M SPIFFS）
#   AEC 采集走 esp-sr AFE 且模型以 MODEL_IN_FLASH 编入应用 ⇒ 应用 ~1.4 MB，超出 IDF 缺省 factory(1M)；
#   SPIFFS 作无 SD 卡时的录音兜底（/spiffs/rec）。
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# PSRAM：AFE/音频任务的 ext-stack 与录音缓冲需要（Korvo-2 板载 ESP32-S3-WROOM-1 带 Octal PSRAM）
#   注：若实物模组为 Quad PSRAM，请把 MODE_OCT 改为 MODE_QUAD（见 README「待真机核对」）。
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#
# FATFS（SD 卡上的录音/媒体文件名可能较长）
#
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_FS_LOCK=5

#
# SPIFFS（兜底录音存储）
#
CONFIG_SPIFFS_MAX_PARTITIONS=3
