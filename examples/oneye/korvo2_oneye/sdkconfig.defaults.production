# =============================================================================
# 量产固件预设（在 sdkconfig.defaults / sdkconfig.defaults.esp32s3 之后再叠加）
#
# 用法（**必须显式叠加**，否则 IDF 只会读 sdkconfig.defaults*）：
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.production" \
#          -DONEYE_FW_CERT_DIR=<空目录> build
#
# 为什么需要单独一份：量产口径与台面口径**恰好相反**的那几条（内嵌证书、本地调试面、SD 卡明文
# Wi-Fi 密码、TLS 跳过校验），靠"记得改"是不可靠的 —— 忘一次就是把一台会拿公用身份上线的机器
# 发出去。所以把它们集中成一份文件，并且与 CMakeLists 里的互斥守卫配合（见 main/CMakeLists.txt：
# REQUIRED=y 与内嵌证书同时成立会直接编不过）。
#
# 依据：backend/contracts/domain/设备凭据分区与产测自证契约.md（§1 分区、§2 失败姿态、§7 红线）
#      与 docs/ops/产线凭证灌注作业指导.md §1.1
#
# ⚠️ 本文件里**每一项**都必须能被验证，而不是"写在文件里就算钉住了"：
#   门禁 `python tools/check-sdkconfig-defaults.py --sdkconfig <构建产物>/sdkconfig \
#          --require sdkconfig.defaults.production`
#   2026-09-23 真构建抓到的教训：曾经这里写的是 `CONFIG_ONEYE_FW_TRANSPORT_MQTT_TLS=y`，
#   而 Kconfig 里的符号叫 `CONFIG_ONEYE_FW_TRANSPORT_TLS`（本工程从来没有 `_MQTT_TLS`）
#   ⇒ 这一行**什么都没做**，整条"显式钉住承载"是安慰剂；同一天真机实测到的正是承载掉回 TCP
#   ⇒ 设备完全不上线。**"写了配置"与"配置生效"在文本上长得一模一样。**
# =============================================================================

# ---- 身份：分区凭据是唯一来源 -------------------------------------------------
# 分区没写过/不存在 ⇒ 也**不许**回退（没有内嵌证书可退，且这条让失败姿态显式化）
CONFIG_ONEYE_DEV_CREDS_REQUIRED=y

# 产线验收：开机打印一行自证串（ONEYE-PROV1 …），供 provverify 验签。
# ⚠️ 不开 = 产线看不到可验的证据，等于跳过验收（契约 §7 红线 3）。同一份固件用于量产与产测。
CONFIG_ONEYE_FW_PROV_ATTEST=y

# ---- 承载与安全 ---------------------------------------------------------------
# 一机一密 mTLS 主承载。**符号名以 main/Kconfig.projbuild 的 `config ONEYE_FW_TRANSPORT_TLS` 为准**；
# 显式写出来是为了"不被别的 defaults 覆盖"，改这一项 = 换承载，必须是有意的。
CONFIG_ONEYE_FW_TRANSPORT_TLS=y
# 云端端点同样钉死：缺省是占位地址（Kconfig `ONEYE_FW_CLOUD_HOST` = 192.168.1.100、端口 0），
# sdkconfig 一旦从 defaults 重新生成就会掉回去 ⇒ 设备能起来但**连不到平台**
# （2026-09-22 真机实测：日志 `cloud endpoint 192.168.1.100:0 → SYN 无应答`）。
#
# ⚠️ **端口必须与"信任签发 CA 的那台监听器"一致**（2026-09-24 真机实测更正，原值 18885）：
#   申领服务签发的设备证书挂在**平台 CA**（`oneye-iot-device-ca`）下，而平台上只有
#   `oneye-platca` 这台 broker 的 `cacertfile` 是平台 CA（宿主端口 **18886**）。
#   原来的 18885 是 `oneye-crl`（另一台老 CA，`mtls-test/certs/ca.crt`）—— 必被拒。
#   实测（拿本批真证书跑 `openssl s_client`）：
#     18886 `Verification: OK`；18885 / 18884 / 8883 全部
#     `self-signed certificate in certificate chain`。
#   现象很像"证书坏了"，实际是端口选错 —— 而端口是**编译期**钉死的，选错只能重烧。
#   换环境时改这里 + 重烧；同一批证书的端点也写在交付物的 README.md 里（§0）。
CONFIG_ONEYE_FW_CLOUD_HOST="mqtt.oneye.me"
CONFIG_ONEYE_FW_CLOUD_PORT=18886
# 绝不跳过证书校验（跳过=中间人可读可改）
# CONFIG_ONEYE_FW_TLS_INSECURE is not set

# ---- 台面能力一律关闭 ---------------------------------------------------------
# SD 卡/SPIFFS 上的 Wi-Fi 凭据是**明文**，量产配网走 claim + 一机一密（ADR-0007）
# CONFIG_ONEYE_FW_ENABLE_WIFI_FILE is not set
# 设备侧本地 HTTP 验证面不是云端设备面契约
# CONFIG_ONEYE_FW_ENABLE_PANEL_API is not set
# 取证插桩（周期性 INFO + 长批量间隔）只用于取证
# CONFIG_ONEYE_FW_LOG_PROBE is not set

# ---- 自检与体积 ---------------------------------------------------------------
# 板级自检失败即中止上云（量产要的是"坏的别上网"，不是"坏的也上网")
CONFIG_ONEYE_FW_SELFTEST_STRICT=y
# 应用分区很紧（实测只剩 ~1%）：量产用体积优先
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
