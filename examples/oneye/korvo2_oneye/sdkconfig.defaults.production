# =============================================================================
# 量产固件预设（在 sdkconfig.defaults / sdkconfig.defaults.esp32s3 之后再叠加）
#
# 用法（**必须显式叠加**，否则 IDF 只会读 sdkconfig.defaults*）：
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.production" \
#          -DONEYE_FW_CERT_DIR=<空目录> build
#
# 🔴 **受控路径（2026-10-07 固化）**：`sdkconfig` 被 `.gitignore:24` 覆盖 ⇒ **不入库**。它是
#    **生成物**，唯一受控来源 = 本文件 ＋ `sdkconfig.defaults` ＋ `sdkconfig.defaults.esp32s3`。
#    所以生产固件**必须由 defaults 派生**，并且**必须显式指定 `-DSDKCONFIG=<构建目录>/sdkconfig`**：
#    不给它时 IDF 的 SDKCONFIG 缺省落在**工程目录**（`<example>/sdkconfig`），而 defaults 只对
#    "尚未存在的符号"生效 —— 工作区里那份 gitignored `sdkconfig` 会**盖住本文件**，本预设看起来
#    "写了却没用"，且构建会反过来**改写**它。产出命令与逐项自证见 README.md §5.10。
#
# 为什么需要单独一份：量产口径与台面口径**恰好相反**的那几条（内嵌证书、本地调试面、SD 卡明文
# Wi-Fi 密码、TLS 跳过校验），靠"记得改"是不可靠的 —— 忘一次就是把一台会拿公用身份上线的机器
# 发出去。所以把它们集中成一份文件，并且与 CMakeLists 里的互斥守卫配合（见 main/CMakeLists.txt：
# REQUIRED=y 与内嵌证书同时成立会直接编不过）。
#
# 依据：backend/contracts/domain/设备凭据分区与产测自证契约.md（§1 分区、§2 失败姿态、§7 红线）
#      与 docs/ops/产线凭证灌注作业指导.md §1.1
#
# ⚠️ 本文件里**每一项**都必须能被验证，而不是"写在文件里就算钉住了"：
#   门禁 `python tools/check-sdkconfig-defaults.py --sdkconfig <构建产物>/sdkconfig \
#          --require sdkconfig.defaults.production`
#   2026-09-23 真构建抓到的教训：曾经这里写的是 `CONFIG_ONEYE_FW_TRANSPORT_MQTT_TLS=y`，
#   而 Kconfig 里的符号叫 `CONFIG_ONEYE_FW_TRANSPORT_TLS`（本工程从来没有 `_MQTT_TLS`）
#   ⇒ 这一行**什么都没做**，整条"显式钉住承载"是安慰剂；同一天真机实测到的正是承载掉回 TCP
#   ⇒ 设备完全不上线。**"写了配置"与"配置生效"在文本上长得一模一样。**
# =============================================================================

# ---- 身份：分区凭据是唯一来源 -------------------------------------------------
# 分区没写过/不存在 ⇒ 也**不许**回退（没有内嵌证书可退，且这条让失败姿态显式化）
CONFIG_ONEYE_DEV_CREDS_REQUIRED=y

# 产线验收：开机打印一行自证串（ONEYE-PROV1 …），供 provverify 验签。
# ⚠️ 不开 = 产线看不到可验的证据，等于跳过验收（契约 §7 红线 3）。同一份固件用于量产与产测。
CONFIG_ONEYE_FW_PROV_ATTEST=y

# ---- 承载与安全 ---------------------------------------------------------------
# 一机一密 mTLS 主承载。**符号名以 main/Kconfig.projbuild 的 `config ONEYE_FW_TRANSPORT_TLS` 为准**；
# 显式写出来是为了"不被别的 defaults 覆盖"，改这一项 = 换承载，必须是有意的。
CONFIG_ONEYE_FW_TRANSPORT_TLS=y
# 云端端点同样钉死：缺省是占位地址（Kconfig `ONEYE_FW_CLOUD_HOST` = 192.168.1.100、端口 0），
# sdkconfig 一旦从 defaults 重新生成就会掉回去 ⇒ 设备能起来但**连不到平台**
# （2026-09-22 真机实测：日志 `cloud endpoint 192.168.1.100:0 → SYN 无应答`）。
#
# ⚠️ **端口必须与"信任签发 CA 的那台监听器"一致**（2026-09-24 真机实测更正，原值 18885）：
#   申领服务签发的设备证书挂在**平台 CA**（`oneye-iot-device-ca`）下，而平台上只有
#   `oneye-platca` 这台 broker 的 `cacertfile` 是平台 CA（宿主端口 **18886**）。
#   原来的 18885 是 `oneye-crl`（另一台老 CA，`mtls-test/certs/ca.crt`）—— 必被拒。
#   实测（拿本批真证书跑 `openssl s_client`）：
#     18886 `Verification: OK`；18885 / 18884 / 8883 全部
#     `self-signed certificate in certificate chain`。
#   现象很像"证书坏了"，实际是端口选错 —— 而端口是**编译期**钉死的，选错只能重烧。
#   换环境时改这里 + 重烧；同一批证书的端点也写在交付物的 README.md 里（§0）。
CONFIG_ONEYE_FW_CLOUD_HOST="mqtt.oneye.me"
CONFIG_ONEYE_FW_CLOUD_PORT=18886
# 绝不跳过证书校验（跳过=中间人可读可改）
# CONFIG_ONEYE_FW_TLS_INSECURE is not set

# ---- 台面能力一律关闭 ---------------------------------------------------------
# SD 卡/SPIFFS 上的 Wi-Fi 凭据是**明文**，量产配网走 claim + 一机一密（ADR-0007）
# CONFIG_ONEYE_FW_ENABLE_WIFI_FILE is not set
# 设备侧本地 HTTP 验证面不是云端设备面契约
# CONFIG_ONEYE_FW_ENABLE_PANEL_API is not set
# 取证插桩（周期性 INFO + 长批量间隔）只用于取证
# CONFIG_ONEYE_FW_LOG_PROBE is not set
# 台面令牌**不得进量产件**：量产身份只来自 `creds` 分区（一机一密 mTLS）。Kconfig 缺省本就是空串，
# 显式写出来是为了让"量产件里没有台面 token"这一条在**生成后的 sdkconfig** 里看得见、可门禁
# （否则它只存在于"没人往里填过"这一无法核对的假设里）。
CONFIG_ONEYE_FW_CLOUD_TOKEN=""

# ---- 自检与体积 ---------------------------------------------------------------
# 板级自检失败即中止上云（量产要的是"坏的别上网"，不是"坏的也上网")
CONFIG_ONEYE_FW_SELFTEST_STRICT=y
# 应用体积优先（-Os）。**与开发板的 app 分区余量无关**：
#   2026-09-30 起开发板台面是 `factory 4M`（余量约 51%），但**本预设描述的是量产口径**，
#   而量产分区形态尚未评审（见 partitions.csv 顶部"开发板台面形态 ≠ 量产结论"）。
#   在"量产 flash 更充裕"（用户裁定）被具体化成一份分区表之前，体积优先是**刻意保留**的选择：
#   它同时换来更小的 OTA 包与更小的 flash 占用，成本只是运行速度。要改这一项 = 改量产口径，须评审。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# =============================================================================
# 自述"量产应置 X"的项 —— 逐条对齐台账（2026-10-07 grep 全仓复核，写区 = 本工程）
#
# 口径：凡固件/README/Kconfig 里**自己写着**"量产应置/必须置 n/y"的开关，都必须在本文件里有
#       对应的显式行；漏一条 = 量产件里悄悄留着台面能力。复核命令（写区内）：
#         grep -rn "量产\|生产" examples/oneye/korvo2_oneye --include=*.md --include=Kconfig*
#         grep -rn "量产应\|量产必须\|生产必须\|不要在生产" components/oneye-dev-sdk
#
#  ① 明文 Wi-Fi 凭据配网
#     · sdkconfig.defaults:95   「量产固件必须置 n」
#     · README.md:200 / :368    「量产**必须置 n**」
#     · main/Kconfig.projbuild:59「量产形态必须关闭（n）」
#     · main/wifi_prov.h:12     「并在量产固件中关闭本文件的读取」
#     ⇒ 本文件:64  `# CONFIG_ONEYE_FW_ENABLE_WIFI_FILE is not set`  ✅
#  ② 设备侧本地验证 HTTP 面（非云端契约）
#     · README.md:210 / :373    「量产应置 CONFIG_ONEYE_FW_ENABLE_PANEL_API=n」
#     · main/Kconfig.projbuild:147「量产固件应置 n」
#     · main/panel_api.h:7      「生产形态下应关闭」
#     · main/media_api.h:11     「量产固件应整体关闭」
#     · main/panel_api.c:1053   固件自己在串口上喊「量产应置 …=n」（台面构建每轮都打这行）
#     ⇒ 本文件:66  `# CONFIG_ONEYE_FW_ENABLE_PANEL_API is not set`  ✅
#  ③ log 面取证插桩
#     · main/Kconfig.projbuild:109「**默认关，不要在生产固件里开**」（该符号 default n）
#     · sdkconfig.defaults:116-117 台面显式开的是"取证插桩"，并注明"量产口径不受本行影响"
#     ⇒ 本文件:68  `# CONFIG_ONEYE_FW_LOG_PROBE is not set`  ✅
#  ④ TLS 跳过证书校验
#     · main/Kconfig.projbuild:43「仅 dev/产测；生产必须 n」
#     · main/korvo2_oneye_main.c:957 注释「生产必须 n 并投放自研 CA」（代码按该宏 `#if` 编译）
#     · README.md:367            「仅 dev/产测可开；生产须投放自研 CA」
#     ⇒ 本文件:60  `# CONFIG_ONEYE_FW_TLS_INSECURE is not set`  ✅
#  ⑤ 分区凭据是唯一身份来源（不许回退公用凭据）
#     · components/oneye-dev-sdk/docs/API-creds.md:53  「**量产必须 `y`**」
#     · components/oneye-dev-sdk/include/oneye_dev_creds.h:97「量产必须为 1」
#     · components/oneye-dev-sdk/docs/INTEGRATION.md:409「量产必须为 y」
#     · main/korvo2_oneye_main.c:863「量产固件应让 ONEYE_DEV_CREDS_REQUIRED=y」
#     · README.md:336
#     ⇒ 本文件:34  `CONFIG_ONEYE_DEV_CREDS_REQUIRED=y`  ✅
#
# **未对齐 / 已知不属本文件能管**（如实登记，不假装对齐）：
#  · SDK 内部源码 `components/oneye-dev-sdk/src/internal/oneye_ble_plat_nimble.c:102/:114/:126`
#    自述「量产应降为 ESP_LOGD（协议正文不落串口，PIPL）」。它在 **SDK 源码**里，而本固件链接的
#    是 SDK 的**预编译库**（见 README §5.6 末段），且本工程未启用 BLE ⇒ 本 defaults 管不到它。
#    要落地必须改 SDK 并重跑 `build-all.sh --toolchains`，属**另一个仓的改动**，本轮未做。
#  · 另一例程 `examples/oneye/korvo2_llm_chat`（自述 `ONEYE_LLM_ENABLE_WIFI_FILE` /
#    `ONEYE_LLM_ENABLE_LAN_LINK` 量产置 n）是**另一份固件**，不在本轮写区，未动。
# =============================================================================
