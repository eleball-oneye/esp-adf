# =============================================================================
# 量产固件预设（在 sdkconfig.defaults / sdkconfig.defaults.esp32s3 之后再叠加）
#
# 用法（**必须显式叠加**，否则 IDF 只会读 sdkconfig.defaults*）：
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.production" \
#          -DONEYE_FW_CERT_DIR=<空目录> build
#
# 🔴 **受控路径（2026-10-07 固化）**：`sdkconfig` 被 `.gitignore:24` 覆盖 ⇒ **不入库**。它是
#    **生成物**，唯一受控来源 = 本文件 ＋ `sdkconfig.defaults` ＋ `sdkconfig.defaults.esp32s3`。
#    所以生产固件**必须由 defaults 派生**，并且**必须显式指定 `-DSDKCONFIG=<构建目录>/sdkconfig`**：
#    不给它时 IDF 的 SDKCONFIG 缺省落在**工程目录**（`<example>/sdkconfig`），而 defaults 只对
#    "尚未存在的符号"生效 —— 工作区里那份 gitignored `sdkconfig` 会**盖住本文件**，本预设看起来
#    "写了却没用"，且构建会反过来**改写**它。产出命令与逐项自证见 README.md §5.10。
#
# 为什么需要单独一份：量产口径与台面口径**恰好相反**的那几条（内嵌证书、本地调试面、SD 卡明文
# Wi-Fi 密码、TLS 跳过校验），靠"记得改"是不可靠的 —— 忘一次就是把一台会拿公用身份上线的机器
# 发出去。所以把它们集中成一份文件，并且与 CMakeLists 里的互斥守卫配合（见 main/CMakeLists.txt：
# REQUIRED=y 与内嵌证书同时成立会直接编不过）。
#
# 依据：backend/contracts/domain/设备凭据分区与产测自证契约.md（§1 分区、§2 失败姿态、§7 红线）
#      与 docs/ops/产线凭证灌注作业指导.md §1.1
#
# ⚠️ 本文件里**每一项**都必须能被验证，而不是"写在文件里就算钉住了"：
#   门禁 `IDF_PATH=<esp-idf 根> python tools/check-sdkconfig-defaults.py --sdkconfig <构建产物>/sdkconfig \
#          --require sdkconfig.defaults.production`
#   ⚠️ `IDF_PATH` **不可省**（2026-10-13 集成验收登记）：符号全集的第三个来源 = `$IDF_PATH/components`
#      的 Kconfig；缺了它，本文件里 IDF 声明的符号会被判"本工程不存在"⇒ 实测**多出 13 条结构性误报**
#      （⛔ 别据此删本文件里的行）。
#   2026-09-23 真构建抓到的教训：曾经这里写的是 `CONFIG_ONEYE_FW_TRANSPORT_MQTT_TLS=y`，
#   而 Kconfig 里的符号叫 `CONFIG_ONEYE_FW_TRANSPORT_TLS`（本工程从来没有 `_MQTT_TLS`）
#   ⇒ 这一行**什么都没做**，整条"显式钉住承载"是安慰剂；同一天真机实测到的正是承载掉回 TCP
#   ⇒ 设备完全不上线。**"写了配置"与"配置生效"在文本上长得一模一样。**
# =============================================================================

# ---- 身份：分区凭据是唯一来源 -------------------------------------------------
# 分区没写过/不存在 ⇒ 也**不许**回退（没有内嵌证书可退，且这条让失败姿态显式化）
CONFIG_ONEYE_DEV_CREDS_REQUIRED=y

# 产线验收：开机打印一行自证串（ONEYE-PROV1 …），供 provverify 验签。
# ⚠️ 不开 = 产线看不到可验的证据，等于跳过验收（契约 §7 红线 3）。同一份固件用于量产与产测。
CONFIG_ONEYE_FW_PROV_ATTEST=y

# ---- 承载与安全 ---------------------------------------------------------------
# 一机一密 mTLS 主承载。**符号名以 main/Kconfig.projbuild 的 `config ONEYE_FW_TRANSPORT_TLS` 为准**；
# 显式写出来是为了"不被别的 defaults 覆盖"，改这一项 = 换承载，必须是有意的。
CONFIG_ONEYE_FW_TRANSPORT_TLS=y
# 云端端点同样钉死：缺省是占位地址（Kconfig `ONEYE_FW_CLOUD_HOST` = 192.168.1.100、端口 0），
# sdkconfig 一旦从 defaults 重新生成就会掉回去 ⇒ 设备能起来但**连不到平台**
# （2026-09-22 真机实测：日志 `cloud endpoint 192.168.1.100:0 → SYN 无应答`）。
#
# ⚠️ **端口必须与"信任签发 CA 的那台监听器"一致**（2026-09-24 真机实测更正，原值 18885）：
#   申领服务签发的设备证书挂在**平台 CA**（`oneye-iot-device-ca`）下，而平台上只有
#   `oneye-platca` 这台 broker 的 `cacertfile` 是平台 CA（宿主端口 **18886**）。
#   原来的 18885 是 `oneye-crl`（另一台老 CA，`mtls-test/certs/ca.crt`）—— 必被拒。
#   实测（拿本批真证书跑 `openssl s_client`）：
#     18886 `Verification: OK`；18885 / 18884 / 8883 全部
#     `self-signed certificate in certificate chain`。
#   现象很像"证书坏了"，实际是端口选错 —— 而端口是**编译期**钉死的，选错只能重烧。
#   换环境时改这里 + 重烧；同一批证书的端点也写在交付物的 README.md 里（§0）。
CONFIG_ONEYE_FW_CLOUD_HOST="mqtt.oneye.me"
CONFIG_ONEYE_FW_CLOUD_PORT=18886
# 绝不跳过证书校验（跳过=中间人可读可改）
# CONFIG_ONEYE_FW_TLS_INSECURE is not set

# ---- 台面能力一律关闭 ---------------------------------------------------------
# ★ 2026-10-07 订正（ADR-0017 D3）：**这一行原来写的是**
#     `# CONFIG_ONEYE_FW_ENABLE_WIFI_FILE is not set`
#   并把理由写成「SD 卡明文 Wi-Fi 密码不得进量产件」。**那个口径是错的**，而且代价极大：
#   它把「机型能力位」当成「量产/台面开关」关掉，于是纯生产件**一个配网通道都不剩**
#   （SD 卡通道被本预设关掉、BLE 通道当时还没接、Kconfig SSID 为空）
#   ⇒ `main/korvo2_oneye_main.c` 的 `!have` 分支 `return`，**`oneye_start()` 从未被调用**，
#      设备永远上不了云；而构建、烧写、串口启动全部正常，故障**静默**
#      （2026-10-07 真机实测，串口原文见 `_tmp-phase2/prod2-serial.txt:170-171`）。
#   ⇒ 本预设**不再**写这一行：
#      · `WIFI_FILE` 由**机型**决定（korvo2_oneye 有卡槽 ⇒ 取 `sdkconfig.defaults` 的 y）；
#      · 无卡槽机型**不能**靠"关掉它"来收场 —— 必须同时打开 BLE 通道（见 `sdkconfig.defaults.ble`），
#        这条由 `main/CMakeLists.txt` 的构建期门禁强制（三条件同时成立即 `FATAL_ERROR`，编不过）。
#      · 明文 Wi-Fi 密码的**残余风险仍在**，但归属改为「配网凭据落盘形态」单独决策
#        （ADR-0017 D3），⛔ 不用"关掉唯一通道"来假装解决。
#      · 🔴 **2026-10-13 就地订正（用户裁定「B1.量产支持且凭据明文」）**：本档下 C3 文件通道是
#        **量产品类形态**（量产**支持**该通道），卡上凭据**明文**这一后果**已由用户裁定接受**
#        ⇒ ⛔ 不再写成"残余风险 / 另外决策"，也⛔ 不再写成"仅台面"。
#        **旧字逐字留痕（⛔ 不抹）**：本两行此前逐字为
#        「· 明文 Wi-Fi 密码的**残余风险仍在**，但归属改为「配网凭据落盘形态」单独决策
#          （ADR-0017 D3），⛔ 不用"关掉唯一通道"来假装解决。」
#        ⛔ 本文件**未增删任何配置符号**（只订正注释口径），故产物 sdkconfig 逐项不变。
# 设备侧本地 HTTP 验证面不是云端设备面契约
# CONFIG_ONEYE_FW_ENABLE_PANEL_API is not set
# 取证插桩（周期性 INFO + 长批量间隔）只用于取证
# CONFIG_ONEYE_FW_LOG_PROBE is not set
# 台面令牌**不得进量产件**：量产身份只来自 `creds` 分区（一机一密 mTLS）。Kconfig 缺省本就是空串，
# 显式写出来是为了让"量产件里没有台面 token"这一条在**生成后的 sdkconfig** 里看得见、可门禁
# （否则它只存在于"没人往里填过"这一无法核对的假设里）。
CONFIG_ONEYE_FW_CLOUD_TOKEN=""

# =============================================================================
# 配网通道（🔴 2026-10-20 用户裁定）：**SD 卡凭据优先 ＋ 拔出 SD 卡时 BLE 回退**
#
# 用户口径（逐字，最高依据，⛔ 不得改写）：
#   「com12 甲型需要支持蓝牙配网使能，**拔出 SD 卡的时候用蓝牙配网，有 SD 卡时用 SD 卡凭据配网**」
#
# 🔴 旧行为（逐字留痕，⛔ 不抹）：本预设此前**不含任何 BLE 符号** ⇒ 本机的量产链
#   （`sdkconfig.defaults` → `.esp32s3` → `.production`）上 `CONFIG_ONEYE_FW_ENABLE_BLE_PROV`
#   未定义、NimBLE 关；有卡槽机型**只有一条** SD 通道 ⇒ 拔出 SD 卡（或卡上没有
#   `oneye-wifi.txt`）后串口止于「未找到可用的 Wi-Fi 凭据 → 本次启动不会上云」，
#   设备**没有任何配网通道**（2026-10-20 14:44 真机取证：
#   `E:\workspace\_oneye-logs\COM12-ALPHA-READINESS-20261020.md` §1.3 与 §4 缺口 #6）。
#
# ✅ 现行为（**只加配置**；判据 / 帧协议 / 收敛点 / 身份来源一字未改）：
#   · 启动顺序与采信 rank **逐字不变**（ADR-0017 D2.1）：C3 文件（rank 0）→ C1/C2 BLE（rank 1）
#     → C5 Kconfig 兜底（rank 2）；`wifi_prov_policy.h` 未动。
#   · **有卡且解析成功** ⇒ `wifi_prov_boot()`（`main/korvo2_oneye_main.c:1303-1309`）在 BLE 段
#     **之前** `return` ⇒ NimBLE **根本不起栈**（"有 SD 时不启 BLE"是**代码结构**保证的，
#     ⛔ 不是靠日志或运行期开关）。
#   · **卡缺失 / 文件缺失或解析失败 / 卡上凭据本次入网失败** ⇒ 落到 BLE 段并**开机即广播**
#     （下面 `ONEYE_FW_BLE_PROV_KEY_GATE` 保持 n ⇒ `set_autostart(true)`；
#     ⛔ 不要求用户先长按 SET 才看得到设备）。文件通道"命中但连不上"的那条另有
#     2026-10-13 D2 的**自动**进入配网模式（`file_fell_back` → `pairing_enter()`）。
#   · **甲型身份不变**：`oneye_start()` 只从 **creds 分区**取 node / 证书 / 私钥
#     （`main/korvo2_oneye_main.c:1491` 的 `oneye_dev_creds_load()`），BLE 通道只下发
#     **Wi-Fi 凭据**；⛔ 不得用激活码顶替甲型 creds 身份（激活码仅作 BLE 配对/核验基准）。
#   · **运行期不热切换**：SD 只在上电时挂载/读取一次 ⇒ 插卡/拔卡都**在下一次复位生效**。
#
# ⚠️ 顺序有语义（2026-10-07 实测，⛔ 不要重排）：`ONEYE_FW_ENABLE_BLE_PROV` 有
#   `depends on ONEYE_DEV_SDK_ENABLE_BLE`，后者又 `depends on ONEYE_DEV_SDK_ENABLE_LINK`、
#   再上还有 `ONEYE_DEV_SDK_ENABLE`；defaults 是**按文件顺序**逐条施加的，给"当前不可见"的
#   符号赋值会被**静默丢弃** ⇒ 被依赖者必须写在依赖者**之前**（下面就是这个次序）。
# =============================================================================
CONFIG_ONEYE_DEV_SDK_ENABLE=y
CONFIG_ONEYE_DEV_SDK_ENABLE_LINK=y
CONFIG_ONEYE_DEV_SDK_ENABLE_BLE=y
CONFIG_ONEYE_FW_ENABLE_BLE_PROV=y
# 档位 = **甲 ALPHA**（choice 缺省即甲，这里**显式**钉住）：与 cloud 侧
# `dev_product_credential_policy(OY-SPK-01)` 的 `credential_required=1` /
# `onboarding_actor=DEVICE` 同源（契约 `ble-gatt.md` §4.4.2；`cred_req=1`、`prov.verify.req` 必经）。
CONFIG_ONEYE_FW_ONBOARDING_ROLE_ALPHA=y
# 按键门控保持 **n**（`# CONFIG_…_KEY_GATE is not set`）：拔卡即广播。
# ⛔ 若把它置 y，拔卡后设备会停在"待机不广播"，必须长按 SET 才出现在 App 里 ——
#    那与用户口径「拔出 SD 卡的时候用蓝牙配网」不符（旧 `sdkconfig.defaults.ble-key` 档不受影响）。
# CONFIG_ONEYE_FW_BLE_PROV_KEY_GATE is not set
# 配网窗口 300 s = SDK 一次性 chal TTL（`CONFIG_ONEYE_DEV_SDK_BLE_CHAL_TTL_S`）；
# ⚠️ 本档 gate=n（开机即广播）时**开机那段不记窗口**；本值在两条路径上生效：
#    ① 长按 SET 进入配网模式；② 卡上凭据"命中但连不上"时的 D2 自动回落（2026-10-13）。
CONFIG_ONEYE_FW_BLE_PROV_PAIRING_WINDOW_S=300

# ---- Wi-Fi + BLE 共存 / NimBLE 取值 ---------------------------------------------
# 逐项照抄**已真机打通**的 `sdkconfig.defaults.ble`（真机取证 2026-09-17：korvo2 上 BLE 配网
# 与音频管线共存）；⛔ 不要在这里"按需精简" —— 每一条都对应一次真机踩出来的崩溃/饥饿
# （主机栈 12 KB、MSYS 12/12、NimBLE 主机侧走 PSRAM、Wi-Fi 缓冲下调）。
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=12288
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16

# ---- mbedTLS 单帧内容上限：**甲型上云 TLS 分配失败的根治项**（2026-10-21）---------
# ⚠️ 本段是**第一版（降档）**，其结论已被同日 15:11 的真机取证**推翻** ⇒ 现行为见本段末尾
#    「二修（批次 KORVO2-TLS-HANDSHAKE-FIX2）」块。本段文字**逐字留痕、⛔ 不删**（仓库纪律）。
# 真机取证（COM12，2026-10-21 14:47，板载 prod 固件 `v2.8-177-g4b5d27b0-dirty`）：
#   Wi-Fi 已连、IP 已取、`net_probe` 到 18886 TCP 通，随后**建 TLS 会话即失败**：
#     W oneye_tls: TLS failed at mbedtls_ssl_setup: ret=-32512 (0x7f00)
#     [W] connect mqtt.oneye.me:18886 (mqtt-tls) failed: rc=-6 (0xfffffffa)
#   0x7f00 = `MBEDTLS_ERR_SSL_ALLOC_FAILED`（IDF 5.5.5
#   components/mbedtls/mbedtls/include/mbedtls/ssl.h:109 逐字
#   `#define MBEDTLS_ERR_SSL_ALLOC_FAILED  -0x7F00`）。
# 成因（与乙型 devkitc **同源**；⛔ 不是"总内存不够"，是"**连续**内存不够"）：
#   `mbedtls_ssl_setup()` 在**建会话**时按下面这两个缺省值**一次性各要一整块连续缓冲**
#   （收 16 KiB ＋ 发 4 KiB ＋ 变换/头部开销），取不到就直接返回该码 ⇒ **连 ClientHello 都发不出去**，
#   云端只看到 TCP SYN→FIN，App 侧表现为"一直等设备上平台"。
#   甲型量产件同时跑 Wi-Fi ＋ NimBLE ＋ ADF 音频 ＋ 配网，内部 RAM 已高度碎片化。
# 本档取证（`build-alpha-ble-fallback/sdkconfig`，与 COM12 板载件**同批**构建）逐字：
#   CONFIG_SPIRAM=y / CONFIG_SPIRAM_MODE_OCT=y / CONFIG_SPIRAM_USE_MALLOC=y
#   # CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set   ← SPIRAM 在，但 **mbedTLS 没走它**
#   # CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
#   ⇒ 那 16 KiB 收缓冲实际落在**内部** RAM ⇒ 碎片化后必然取不到。
# 为什么本档**不**走 PSRAM（台面档 `sdkconfig.defaults.bench-local:120` 的做法）：
#   那条路用 PSRAM 保住 16384 B 标准口径，代价是 TLS 缓冲/上下文全走外部 RAM（延迟）；
#   本批按用户裁定「最小改动、与乙型同口径」⇒ 选择**降档**，不新增第二条内存路径。
#   ⛔ 将来若确有 >4096 B 的下行需求：**先**改走 PSRAM（`CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC`）
#   **再**回抬本值 —— ⛔ 不要只把本值改回 16384（那等于把本次失败原样搬回来）。
# 判据（为什么这两个值够用）：
#   · 入向 4096 B：下行帧 = MQTT 影子/命令载荷，单条报文远小于 4 KiB；
#   · 出向 2048 B：设备→云的上报（status/shadow/log）实际帧远小于 2 KiB。
#   ⚠️ 上面两行"远小于"沿用乙型口径，**本批尚未在 korvo2 上逐帧实测复核**（见报告 §5 缺口）。
# ⚠️ 这是**折衷不是免费**：单帧超过 4096 B 的下行报文会被 mbedtls 拒收（`BUFFER_TOO_SMALL` 一类症状）。
# ★ 旧值逐字留痕（⛔ 不删）：此前**这两个符号不在本文件里**，取 IDF 缺省
#   `CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384` / `CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096`；
#   实测读自 `build-alpha-ble-fallback/sdkconfig`（2026-10-20 那批，与板载固件同批）。
#   ⛔ 本段是**本文件唯一**的配置符号新增，判据/帧协议/身份来源/配网通道一律未动。
# ---------------------------------------------------------------------------
# 二修（批次 KORVO2-TLS-HANDSHAKE-FIX2，2026-10-21 15:2x）：**恢复 IDF 缺省档 + mbedTLS 全走 PSRAM**
#
# 真机取证（COM12，2026-10-21 15:11，板载 = 上面第一版降档固件 4096/2048）：
#   W (457357) oneye_tls: TLS handshake failed: ret=-16 (0x0010) verify_result=0xffffffff
#   [W] connect mqtt.oneye.me:18886 (mqtt-tls) failed: rc=-6 (0xfffffffa)
#   ⇒ -16 (0x0010) **不是** "OUT=2048 太小"，而是 `MBEDTLS_ERR_MPI_ALLOC_FAILED`：
#     · 定义：IDF 5.5.5 components/mbedtls/mbedtls/include/mbedtls/bignum.h:39
#       `#define MBEDTLS_ERR_MPI_ALLOC_FAILED  -0x0010`
#     · 返回点：同树 library/bignum.c:218-219（`mbedtls_mpi_grow` 里
#       `mbedtls_calloc(nblimbs, ciL) == NULL` ⇒ 直接返回该码）
#     · 含义：握手期的大数（ECDHE 密钥生成 / 证书公钥验签）小块**分配不到**
#       ⇒ 仍是**内存**问题，只是失败点从 `mbedtls_ssl_setup`（第一版 -0x7F00）挪到了握手内部。
#     · `verify_result=0xFFFFFFFF` 是 mbedtls 的"**没有会话对象可查**"（library/ssl_tls.c:3157-3168
#       仅当 session / session_negotiate 都为 NULL 才返回它）⇒ 失败发生在**证书校验之前**，
#       ⛔ 不能用它读"证书为什么没验过"。
#     · 若真因是"单帧超 2048 B"，mbedtls 会给 `MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL`(-0x7180) 一类，
#       ⛔ 不会给 -0x0010 ⇒ 本次把"OUT 太小"这个假设**排除**。
#
# 为什么选「PSRAM 路线」而不是继续降档 / 折中档 8192+4096：
#   ① 降档只挪动了**失败点**，没解决"内部 RAM 里分配 mbedTLS 对象"这一根因（第一版已证）；
#   ② 8192/4096 不开 PSRAM 反而把**连续**内部需求从 6 KiB 抬到 12 KiB，且 bignum 小块仍落内部
#      ⇒ 同一类失败的概率更高，⛔ 不选；
#   ③ PSRAM 实测 free_psram=8004572 B（2026-10-21 13:54 那批 `[res]` 行，甲型量产链、
#      Wi-Fi+NimBLE+ADF 全起之后）⇒ 16 KiB+4 KiB 缓冲与全部 bignum 都搬过去毫无压力，
#      并可回到 **13:54 那台真机跑通过握手/上线**的 IDF 缺省档（16384/4096）。
#   ④ 分配器口径（已核对，满足 mbedTLS 要求）：
#      IDF 5.5.5 components/mbedtls/port/esp_mem.c:15-20
#        `#ifdef CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC  → heap_caps_calloc(..., MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT)`
#        `#elif CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC  → heap_caps_calloc(..., MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT)`
#      Kconfig: components/mbedtls/Kconfig:31-33 `MBEDTLS_EXTERNAL_MEM_ALLOC` 依赖
#        `SPIRAM_USE_CAPS_ALLOC || SPIRAM_USE_MALLOC` ⇒ 本档 `CONFIG_SPIRAM_USE_MALLOC=y` **满足**。
#      并且 mbedTLS 的缓冲**不要求 DMA 能力**：收发走 `oneye_osal_sock_*`（lwIP 自己的内部缓冲），
#      mbedTLS 只是软件读写这块内存 ⇒ `MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT` 就是正确 caps，
#      ⛔ 不存在"mbedTLS 只许内部 RAM"的限制。
#   ⑤ 代价（如实登记）：TLS 上下文/编解码全在外部 RAM ⇒ 有 PSRAM 访问延迟；
#      本机不跑 light-sleep/deep-sleep 保 PSRAM，故不存在"睡醒丢上下文"的问题。
#
# ★ 旧值逐字留痕（⛔ 不删）：本批**上一版**在这里逐字为
#     `CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096`
#     `CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048`
#   （2026-10-21 15:03 批次 KORVO2-TLS-MEM-FIX 引入；再上一版 = 不在本文件、取 IDF 缺省 16384/4096，
#    回读见 `build-alpha-tlsmem/sdkconfig`）。
# ---------------------------------------------------------------------------
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# ---- 自检与体积 ---------------------------------------------------------------
# 板级自检失败即中止上云（量产要的是"坏的别上网"，不是"坏的也上网")
CONFIG_ONEYE_FW_SELFTEST_STRICT=y
# 应用体积优先（-Os）。**与开发板的 app 分区余量无关**：
#   2026-09-30 起开发板台面是 `factory 4M`（余量约 51%），但**本预设描述的是量产口径**，
#   而量产分区形态尚未评审（见 partitions.csv 顶部"开发板台面形态 ≠ 量产结论"）。
#   在"量产 flash 更充裕"（用户裁定）被具体化成一份分区表之前，体积优先是**刻意保留**的选择：
#   它同时换来更小的 OTA 包与更小的 flash 占用，成本只是运行速度。要改这一项 = 改量产口径，须评审。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# =============================================================================
# 自述"量产应置 X"的项 —— 逐条对齐台账（2026-10-07 grep 全仓复核，写区 = 本工程）
#
# 口径：凡固件/README/Kconfig 里**自己写着**"量产应置/必须置 n/y"的开关，都必须在本文件里有
#       对应的显式行；漏一条 = 量产件里悄悄留着台面能力。复核命令（写区内）：
#         grep -rn "量产\|生产" examples/oneye/korvo2_oneye --include=*.md --include=Kconfig*
#         grep -rn "量产应\|量产必须\|生产必须\|不要在生产" components/oneye-dev-sdk
#
#  ① 明文 Wi-Fi 凭据配网 —— **2026-10-07 台账订正：这一条从「必须置 n」里移除**（ADR-0017 D3）
#     · 旧自述（已全部改口径）：sdkconfig.defaults:95「量产固件必须置 n」、
#       README.md「量产必须置 n」、main/Kconfig.projbuild:59「量产形态必须关闭（n）」、
#       main/wifi_prov.h:12「并在量产固件中关闭本文件的读取」。
#     · 为什么不是对齐项：`ONEYE_FW_ENABLE_WIFI_FILE` 是**机型能力位**（有卡槽机型 y / 无卡槽机型 n），
#       不是量产/台面开关。把它当"量产必须关"的直接后果是 **纯生产件没有任何配网通道 ⇒
#       `oneye_start()` 永不调用 ⇒ 上不了云**（2026-10-07 真机实测）。
#     ⇒ **本文件不写这一行**；由机型 defaults 决定，并由 main/CMakeLists.txt 的构建期门禁
#       「无任何可用通道 ⇒ FATAL_ERROR」兜底。SD 卡明文密码的残余风险按 ADR-0017 D3 另行决策。
#       🔴 **2026-10-13 就地订正（用户裁定「B1.量产支持且凭据明文」）**：末句作废 ——
#       量产**支持** C3 文件通道，卡上凭据**明文**的后果**已由用户裁定接受**（⛔ 不再"另行决策"）。
#       **旧字逐字留痕（⛔ 不抹）**：本句此前逐字为
#       「SD 卡明文密码的残余风险按 ADR-0017 D3 另行决策。」
#       ⛔ 本文件**未增删任何配置符号**（只订正注释口径）。
#  ② 设备侧本地验证 HTTP 面（非云端契约）
#     · README.md:210 / :373    「量产应置 CONFIG_ONEYE_FW_ENABLE_PANEL_API=n」
#     · main/Kconfig.projbuild:147「量产固件应置 n」
#     · main/panel_api.h:7      「生产形态下应关闭」
#     · main/media_api.h:11     「量产固件应整体关闭」
#     · main/panel_api.c:1053   固件自己在串口上喊「量产应置 …=n」（台面构建每轮都打这行）
#     ⇒ 本文件:66  `# CONFIG_ONEYE_FW_ENABLE_PANEL_API is not set`  ✅
#  ③ log 面取证插桩
#     · main/Kconfig.projbuild:109「**默认关，不要在生产固件里开**」（该符号 default n）
#     · sdkconfig.defaults:116-117 台面显式开的是"取证插桩"，并注明"量产口径不受本行影响"
