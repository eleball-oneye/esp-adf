menu "thermometer-t31 例程配置"

    config ONEYE_T31_NODE_ID
        string "网关节点 ID（Oneye 主题用）"
        default "OE-GW-C6-0001"
        help
            该 ID 出现在 MQTT 主题 rmng/dev/{node_id}/event/up 中。
            每台网关必须唯一。

    config ONEYE_T31_MAX_LINKS
        int "并发连接的 T31 数量"
        range 1 8
        default 4
        help
            受 CONFIG_BT_CTRL_BLE_MAX_ACT 与内存限制；工程建议 ≤8。

    config ONEYE_T31_WIFI_SSID
        string "Wi-Fi SSID（留空 = 不联网，仅本地打印）"
        default ""

    config ONEYE_T31_WIFI_PASSWORD
        string "Wi-Fi 密码"
        default ""

    config ONEYE_T31_MQTT_URI
        string "MQTT Broker URI"
        default "mqtt://192.168.1.10:1883"

    config ONEYE_T31_MQTT_USERNAME
        string "MQTT 用户名（可空）"
        default ""

    config ONEYE_T31_MQTT_PASSWORD
        string "MQTT 密码（可空）"
        default ""

    config ONEYE_T31_PASSTHROUGH_UNKNOWN
        bool "未命中档案的子设备也接入（原始帧透传）"
        default y

endmenu
