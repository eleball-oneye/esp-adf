# thermometer-t31 默认配置（适用于 ESP32-C6-GEEK / ESP32-S3 / C3）
# 目标：BLE 中心 4 连接 + Wi-Fi 上行 + MQTT

# ---- BLE（NimBLE，比 Bluedroid 省 RAM）----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# 控制器实例数 = 连接数 + 广播/扫描实例（扫描 1 个 → 4+2=6）
CONFIG_BT_CTRL_BLE_MAX_ACT=6

# ---- Wi-Fi + MQTT ----
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_BUFFER_SIZE=2048
CONFIG_MQTT_TASK_STACK_SIZE=4096

# ---- lwIP / 网络 ----
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=16

# ---- 主任务与日志 ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
